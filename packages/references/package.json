{
  "name": "@nau/references",
  "version": "0.1.0",
  "description": "References' domain rules — the note shape, organization, review intent — agnostic of any transport or persistence",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./relations/gtd": {
      "import": "./dist/relations/gtd/index.js",
      "require": "./dist/relations/gtd/index.js",
      "types": "./dist/relations/gtd/index.d.ts"
    },
    "./relations/actions": {
      "import": "./dist/relations/actions/index.js",
      "require": "./dist/relations/actions/index.js",
      "types": "./dist/relations/actions/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "zod": "^4.3.6"
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    /**
     * `moduleResolution: "node"` does not resolve a package's subpath
     * exports (`@nau/actions/relations/gtd`, `@nau/journal/relations/gtd`)
     * even though they resolve correctly at runtime — same gap `apps/api`
     * hit and fixed the same way (see its own `tsconfig.json`, filed as
     * part of nau#114). A scoped `paths` entry per subpath, not a
     * monorepo-wide switch to `node16`/`bundler`.
     */
    "paths": {
      "@nau/actions/relations/gtd": ["../actions/dist/relations/gtd/index.d.ts"],
      "@nau/journal/relations/gtd": ["../journal/dist/relations/gtd/index.d.ts"],
      "@nau/references/relations/gtd": ["../references/dist/relations/gtd/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}

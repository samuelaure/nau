datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ── Identity ──────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String?
  telegramId         String?  @unique
  defaultWorkspaceId String?
  // IANA zone. A person's day starts and ends where they are, and the journal is
  // organised by day: without this every period boundary falls on the server's
  // midnight, which for a user in Madrid cuts the day at 02:00 local.
  timezone           String   @default("UTC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspaces WorkspaceMember[]
  sessions   Session[]
  linkTokens AuthLinkToken[]
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenFamily String // groups all rotated descendants of one login; reuse = revoke family
  tokenHash   String   @unique // SHA-256 hex hash of the opaque refresh token
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
}

model AuthLinkToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String? // null in bot-initiated flow (user unknown until accounts page login)
  telegramId String? // null in app-initiated flow (unknown until bot catches the deep link)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model ServiceClient {
  id         String   @id @default(cuid())
  slug       String   @unique // e.g. "flownau", "nauthenticity", "zazu-bot"
  secretHash String // bcrypt hash of the service's signing secret
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Workspace ─────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      WorkspaceMember[]
  brands       Brand[]
  projects     Project[]
  inviteTokens InviteToken[]
  tags         Tag[]
  blocks       Block[]
}

model WorkspaceMember {
  id                   String        @id @default(cuid())
  userId               String
  workspaceId          String
  role                 WorkspaceRole @default(OWNER)
  notificationSettings Json          @default("{}")
  createdAt            DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model InviteToken {
  id           String        @id @default(cuid())
  token        String        @unique
  email        String
  workspaceId  String
  role         WorkspaceRole @default(MEMBER)
  createdById  String
  usedAt       DateTime?
  usedByUserId String?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

// ── Brand ─────────────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  handle      String
  language    String   @default("Spanish")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialProfiles SocialProfile[]
  prompts        Prompt[]
  projects       Project[]

  @@unique([workspaceId, handle])
  @@index([workspaceId])
}

// ── Project ───────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([brandId])
}

// ── Social Profile ────────────────────────────────────────────────────────────

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
}

enum SocialProfileRole {
  OWNED
  COMMENT_TARGET
  BENCHMARK_TARGET
  INSPIRATION
}

model SocialProfile {
  id          String            @id @default(cuid())
  brandId     String
  platform    SocialPlatform
  platformId  String // platform-native user/channel ID for dedup
  handle      String
  displayName String?
  role        SocialProfileRole
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, platform, platformId, role])
  @@index([brandId])
  @@index([platform, platformId])
}

// ── Prompt ────────────────────────────────────────────────────────────────────

enum PromptOwnerType {
  WORKSPACE
  BRAND
  USER
}

enum PromptType {
  VOICE
  IDEAS_FRAMEWORK
  CONTENT_PERSONA
  COMPOSITOR
  CAPTION
  COMMENT_STRATEGY
  BENCHMARK_CHAT
}

model Prompt {
  id        String          @id @default(cuid())
  ownerType PromptOwnerType
  ownerId   String
  type      PromptType
  body      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Optional FK for brand-scoped prompts (facilitates cascade delete)
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId, type])
  @@index([ownerType, ownerId])
}

// ── Second Brain ──────────────────────────────────────────────────────────────

model Block {
  id         String @id @default(cuid())
  type       String
  properties Json   @default("{}")

  workspaceId String?
  userId      String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Block?  @relation("BlockChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Block[] @relation("BlockChildren")

  relationsFrom Relation[] @relation("FromBlock")
  relationsTo   Relation[] @relation("ToBlock")

  schedule    Schedule?
  timeEntries TimeEntry[]
  events      Event[]
  tags        BlockTag[]

  uuid      String    @unique @default(uuid())
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  source    String?
  sourceRef String?

  @@index([workspaceId])
  @@index([userId])
}

model Relation {
  id         String @id @default(cuid())
  type       String
  properties Json   @default("{}")

  fromBlockId String
  fromBlock   Block  @relation("FromBlock", fields: [fromBlockId], references: [id], onDelete: Cascade)
  toBlockId   String
  toBlock     Block  @relation("ToBlock", fields: [toBlockId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromBlockId, toBlockId, type])
}

/// When a block is meant to happen. The plan, never the record.
///
/// The range is what carries the intent, and it is deliberately not always a
/// point: an action due today is start = end = today, while one deferred to
/// "sometime this week" is start = Monday, end = Sunday. Widening the range is
/// how something moves from a day to a week to a quarter without changing shape.
///
/// Recurrence follows RFC 5545. `rrule` holds one rule string; occurrences are
/// DERIVED from it and never stored — a daily habit would otherwise be 365 rows
/// a year saying nothing the rule does not already say. Only a deviation earns a
/// row, in ScheduleException.
///
/// `timezone` is required for a rule to mean anything: "every weekday at 08:00"
/// resolves to different instants either side of a daylight-saving change, and
/// without a zone the rule silently drifts by an hour twice a year.
model Schedule {
  id      String @id @default(cuid())
  blockId String @unique
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime?

  rrule    String?
  /// IANA zone the rule is read in. Null means the workspace's own zone.
  timezone String?

  /// Where the rule counts from. See RecurrenceMode.
  recurrenceMode RecurrenceMode @default(FIXED)

  /// Kept for blocks that are not recurring, where completion is a property of
  /// the schedule itself. For recurring ones, completion belongs to an
  /// occurrence and lives in Event — a habit has no single completion date.
  completedAt DateTime?

  exceptions ScheduleException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}

/// Where a recurrence rule counts from.
///
/// RFC 5545 only describes FIXED: an RRULE is a pure function of DTSTART, which
/// is what lets a calendar answer for 2030 without knowing what anyone did. That
/// is the right model for "write in the journal every day" — missing today does
/// not make tomorrow count double.
///
/// It cannot describe the other kind at all. "Shave three days after the last
/// shave" depends on completion history: shaving a day late should push the next
/// one a day out, not leave it where the calendar originally said. Todoist draws
/// the same line between `every 3 days` and `every! 3 days`.
enum RecurrenceMode {
  /// Counts from startDate and never moves.
  FIXED
  /// Counts from the last completion, and moves with it.
  AFTER_COMPLETION
}

enum ScheduleExceptionKind {
  /// The occurrence does not happen. RFC 5545 EXDATE.
  SKIPPED
  /// The occurrence happens at a different time. RFC 5545 RECURRENCE-ID.
  MOVED
}

/// A single occurrence that departs from its rule.
///
/// The only reason an occurrence is ever stored. Everything a rule predicts is
/// computed on read; this table holds the exceptions to it, which is the same
/// shape every calendar system uses.
model ScheduleException {
  id String @id @default(cuid())

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// The instant the rule predicted, which is how the exception is matched back
  /// to the occurrence it replaces.
  occurrenceAt DateTime
  kind         ScheduleExceptionKind
  /// Where it moved to. Null when skipped.
  movedTo      DateTime?

  createdAt DateTime @default(now())

  @@unique([scheduleId, occurrenceAt])
  @@index([scheduleId])
}

/// Real time spent on something. A fact about the past, never a plan.
///
/// Separate from Schedule on purpose: a plan is edited, a session happened and
/// does not change. One block accumulates many sessions, which is how a task
/// worked across three sittings stays one task.
///
/// Shape follows every time tracker that exists — Toggl, Harvest, Clockify.
model TimeEntry {
  id String @id @default(cuid())

  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  workspaceId String?
  userId      String?

  startedAt DateTime
  /// Null while a session is still running.
  endedAt   DateTime?
  note      String?

  createdAt DateTime @default(now())

  @@index([blockId])
  @@index([workspaceId, startedAt])
}

/// A way of dividing time. Gregorian is one of several, not the ground truth.
///
/// The naŭ calendar runs 9-day weeks and 27-day months; astrological periods
/// follow transits; personal epochs follow where someone was living. Each is a
/// different way of grouping the same instants, so the calendar decides how a
/// range is named and bounded, never what the data is.
///
/// Ordinary periods are DERIVED from a date range — "August 2026" needs no row.
/// Only named or irregular ones are stored, in Period.
model Calendar {
  id          String       @id @default(cuid())
  kind        CalendarKind
  name        String
  /// Null for the built-in calendars, which every workspace can use.
  workspaceId String?
  isDefault   Boolean      @default(false)

  periods Period[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, kind, name])
}

enum CalendarKind {
  GREGORIAN
  NAU
  ASTROLOGICAL
  /// Personal epochs: a stay in one country, a trip, a chapter of a life.
  PERSONAL
}

/// A named stretch of time.
///
/// Rows exist only where a range cannot be computed — a personal epoch, or a
/// period someone chose to name. "The year of the dragon" recalls a life in a
/// way "2024" does not, and that name is the entire reason this table exists.
model Period {
  id String @id @default(cuid())

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  workspaceId String?

  name     String?
  startsAt DateTime
  endsAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, startsAt])
  @@index([calendarId])
}

/// Append-only record of what happened to a block and when.
///
/// The journal reads this to reconstruct a day's activity: a block's current
/// state says what is true now, never when it became true. `status: 'done'`
/// carries no completion time, and `Block.updatedAt` is overwritten by the next
/// edit, so without this log "what did I finish today" is unanswerable.
///
/// workspaceId and userId are denormalised so a day can be queried without
/// joining Block — and so the record survives its block being hard-deleted,
/// which is itself an event worth keeping.
model Event {
  id       String @id @default(cuid())
  type     String
  metadata Json   @default("{}")

  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  workspaceId String?
  userId      String?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([blockId])
}

model SyncCursor {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  lastSyncedAt DateTime
  updatedAt    DateTime @updatedAt

  @@unique([userId, workspaceId])
}

// ── Tags ──────────────────────────────────────────────────────────────────────

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Tag?       @relation("TagChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Tag[]      @relation("TagChildren")
  blocks    BlockTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model BlockTag {
  blockId String
  tagId   String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blockId, tagId])
}

// ── Usage Tracking ────────────────────────────────────────────────────────────

model UsageEvent {
  id String @id @default(cuid())

  workspaceId String
  brandId     String?
  userId      String?

  service   String // "api" | "flownau" | "nauthenticity" | "zazu-bot"
  operation String // "chat_completion" | "embedding" | "transcription" | "apify_scrape"
  model     String? // "gpt-4o" | "text-embedding-3-small" | "whisper-1" | null
  provider  String? // "openai" | "groq" | "apify" | null

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  quantity         Float? // units consumed (e.g. characters, pages, API calls)
  unit             String? // "tokens" | "characters" | "calls"
  costUsd          Float? // estimated cost in USD

  metadata Json @default("{}")

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([brandId, createdAt])
  @@index([service, operation, createdAt])
}

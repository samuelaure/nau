datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ── Identity ──────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String?
  telegramId         String?  @unique
  defaultWorkspaceId String?
  // IANA zone. A person's day starts and ends where they are, and the journal is
  // organised by day: without this every period boundary falls on the server's
  // midnight, which for a user in Madrid cuts the day at 02:00 local.
  timezone           String   @default("UTC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspaces WorkspaceMember[]
  sessions   Session[]
  linkTokens AuthLinkToken[]
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenFamily String // groups all rotated descendants of one login; reuse = revoke family
  tokenHash   String   @unique // SHA-256 hex hash of the opaque refresh token
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
}

model AuthLinkToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String? // null in bot-initiated flow (user unknown until accounts page login)
  telegramId String? // null in app-initiated flow (unknown until bot catches the deep link)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model ServiceClient {
  id         String   @id @default(cuid())
  slug       String   @unique // e.g. "flownau", "nauthenticity", "zazu-bot"
  secretHash String // bcrypt hash of the service's signing secret
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Workspace ─────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      WorkspaceMember[]
  brands       Brand[]
  projects     Project[]
  inviteTokens InviteToken[]
  tags         Tag[]
  blocks       Block[]
  timezones    WorkspaceTimezone[]
}

model WorkspaceMember {
  id                   String        @id @default(cuid())
  userId               String
  workspaceId          String
  role                 WorkspaceRole @default(OWNER)
  notificationSettings Json          @default("{}")
  createdAt            DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model InviteToken {
  id           String        @id @default(cuid())
  token        String        @unique
  email        String
  workspaceId  String
  role         WorkspaceRole @default(MEMBER)
  createdById  String
  usedAt       DateTime?
  usedByUserId String?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

// ── Brand ─────────────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  handle      String
  language    String   @default("Spanish")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialProfiles SocialProfile[]
  prompts        Prompt[]
  projects       Project[]

  @@unique([workspaceId, handle])
  @@index([workspaceId])
}

// ── Project ───────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([brandId])
}

// ── Social Profile ────────────────────────────────────────────────────────────

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
}

enum SocialProfileRole {
  OWNED
  COMMENT_TARGET
  BENCHMARK_TARGET
  INSPIRATION
}

model SocialProfile {
  id          String            @id @default(cuid())
  brandId     String
  platform    SocialPlatform
  platformId  String // platform-native user/channel ID for dedup
  handle      String
  displayName String?
  role        SocialProfileRole
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, platform, platformId, role])
  @@index([brandId])
  @@index([platform, platformId])
}

// ── Prompt ────────────────────────────────────────────────────────────────────

enum PromptOwnerType {
  WORKSPACE
  BRAND
  USER
}

enum PromptType {
  VOICE
  IDEAS_FRAMEWORK
  CONTENT_PERSONA
  COMPOSITOR
  CAPTION
  COMMENT_STRATEGY
  BENCHMARK_CHAT
}

model Prompt {
  id        String          @id @default(cuid())
  ownerType PromptOwnerType
  ownerId   String
  type      PromptType
  body      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Optional FK for brand-scoped prompts (facilitates cascade delete)
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId, type])
  @@index([ownerType, ownerId])
}

// ── Second Brain ──────────────────────────────────────────────────────────────

model Block {
  id         String @id @default(cuid())
  type       String
  properties Json   @default("{}")

  workspaceId String?
  userId      String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Block?  @relation("BlockChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Block[] @relation("BlockChildren")

  relationsFrom Relation[] @relation("FromBlock")
  relationsTo   Relation[] @relation("ToBlock")

  planning    Planning?
  events      Event[]
  tags        BlockTag[]

  uuid      String    @unique @default(uuid())
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  source    String?
  sourceRef String?

  @@index([workspaceId])
  @@index([userId])
}

model Relation {
  id         String @id @default(cuid())
  type       String
  properties Json   @default("{}")

  fromBlockId String
  fromBlock   Block  @relation("FromBlock", fields: [fromBlockId], references: [id], onDelete: Cascade)
  toBlockId   String
  toBlock     Block  @relation("ToBlock", fields: [toBlockId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromBlockId, toBlockId, type])
}

/// When a block is meant to happen. The plan, never the record.
///
/// The range is what carries the intent, and it is deliberately not always a
/// point: an action due today is start = end = today, while one deferred to
/// "sometime this week" is start = Monday, end = Sunday. Widening the range is
/// how something moves from a day to a week to a quarter without changing shape.
///
/// Recurrence follows RFC 5545. `rrule` holds one rule string; occurrences are
/// DERIVED from it and never stored — a daily habit would otherwise be 365 rows
/// a year saying nothing the rule does not already say. Only a deviation earns a
/// row, in ScheduleException.
///
/// `timezone` is required for a rule to mean anything: "every weekday at 08:00"
/// resolves to different instants either side of a daylight-saving change, and
/// without a zone the rule silently drifts by an hour twice a year.
model Planning {
  id      String @id @default(cuid())
  blockId String @unique
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  /// WHERE this was placed: which time system, which of its scales, and an
  /// instant inside the period. This triple is the identity, and it is the
  /// truth — it names the period rather than measuring it, so it survives a
  /// timezone change with nothing to migrate.
  system String @default("gregorian")
  scale  String @default("day")
  anchor DateTime

  /// The resolved interval, DERIVED from the triple above and stored only so a
  /// query can filter on an index instead of resolving every system in memory.
  /// Half-open: [from, to). Rebuildable at any time from {system, scale, anchor}
  /// — never edit it independently.
  from DateTime
  to   DateTime

  /// The repetition rule, in whatever dialect its system speaks. Gregorian
  /// stores RFC 5545; nothing outside that system may parse this.
  recurrence String?
  /// IANA zone the rule is read in. Null means the workspace's own zone. A rule
  /// is an intention about a wall clock, so it carries its zone separately from
  /// the instants it produces.
  recurrenceTimezone String?

  /// Where the rule counts from. See RecurrenceMode.
  recurrenceMode RecurrenceMode @default(FIXED)

  overrides OccurrenceOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([from, to])
  @@index([system, scale])
}

/// Where a recurrence rule counts from.
///
/// RFC 5545 only describes FIXED: an RRULE is a pure function of DTSTART, which
/// is what lets a calendar answer for 2030 without knowing what anyone did. That
/// is the right model for "write in the journal every day" — missing today does
/// not make tomorrow count double.
///
/// It cannot describe the other kind at all. "Shave three days after the last
/// shave" depends on completion history: shaving a day late should push the next
/// one a day out, not leave it where the calendar originally said. Todoist draws
/// the same line between `every 3 days` and `every! 3 days`.
enum RecurrenceMode {
  /// Counts from startDate and never moves.
  FIXED
  /// Counts from the last completion, and moves with it.
  AFTER_COMPLETION
}

enum OverrideKind {
  /// The occurrence does not happen. RFC 5545 EXDATE.
  SKIPPED
  /// The occurrence happens at a different time. RFC 5545 RECURRENCE-ID.
  MOVED
}

/// A single occurrence that departs from its rule.
///
/// The only reason an occurrence is ever stored. Everything a rule predicts is
/// computed on read; this table holds the deliberate departures from it, which
/// is the same shape every calendar system uses. Not called an exception
/// because it is a decision, not an error.
model OccurrenceOverride {
  id String @id @default(cuid())

  planningId String
  planning   Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  /// The instant the rule predicted, which is how the override is matched back
  /// to the occurrence it replaces.
  occurrenceAt DateTime
  kind         OverrideKind
  /// Where it moved to. Null when skipped.
  movedTo      DateTime?

  createdAt DateTime @default(now())

  @@unique([planningId, occurrenceAt])
  @@index([planningId])
}


/// Where a workspace has lived, and since when.
///
/// A single current zone is not enough. Someone spends a season in Madrid and
/// then moves to Mexico City; with one field, changing it silently
/// reinterprets every period they ever recorded, and "August 2026" starts
/// resolving in Mexico although it was lived in Spain.
///
/// A period of the past is resolved with the zone in force then. That works
/// only because a period's stored truth is {system, scale, anchor} — had the
/// interval been stored, every past period would need migrating on each move.
///
/// Workspace.timezone remains as a cache of the most recent row so ordinary
/// queries do not pay a join.
model WorkspaceTimezone {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// IANA zone.
  timezone    String
  /// The instant this zone came into force.
  effectiveAt DateTime

  createdAt DateTime @default(now())

  @@index([workspaceId, effectiveAt])
}

/// How one workspace has configured one time system.
///
/// A row exists only where a workspace changed something. Defaults live in the
/// system's own code, so there is no shared built-in row for every workspace to
/// borrow and accidentally write to.
///
/// `config` is the system's own shape and only that system validates it:
/// Gregorian carries `firstDayOfWeek`; the naŭ calendar cannot be asked that
/// question at all, and ephemeris has no weeks. Hanging the setting off the
/// person would force every system to carry options that mean nothing to it.
model TimeSystemConfig {
  id          String  @id @default(cuid())
  workspaceId String
  /// 'gregorian' | 'nau' | 'ephemeris' | 'triggers'
  system      String
  /// Whether this system is active as a view for this workspace.
  enabled     Boolean @default(true)
  config      Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, system])
}



/// A period someone gave a name to, or hung something from.
///
/// Periods are COMPUTED, not stored. "August 2026" needs no row, and
/// materialising every period of every active system would mean rows forever
/// and a table that can drift from the rule that generated it.
///
/// A row appears only when a period acquires something of its own: a title the
/// person chose, or a synthesis hanging off it.
///
/// Identity is {system, scale, anchor} — never a from/to match. Matching on
/// instants fails three ways: two computations of the same period differ by a
/// millisecond, a naŭ and a Gregorian week that coincide would collide, and a
/// timezone change moves the interval and orphans whatever hung from it.
model NamedPeriod {
  id          String @id @default(cuid())
  workspaceId String

  system String
  scale  String
  /// An instant inside the period. Names it without measuring it.
  anchor DateTime

  /// What the person called it — "El Encuentro". The system's own name
  /// ("agosto de 2026") is computed and never stored.
  ///
  /// Belongs to the period rather than to any synthesis of it: a future period
  /// can be named before it has any content, and regenerating a synthesis must
  /// not put the name at risk.
  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, system, scale, anchor])
  @@index([workspaceId, anchor])
}

/// Append-only record of what happened to a block and when.
///
/// The journal reads this to reconstruct a day's activity: a block's current
/// state says what is true now, never when it became true. `status: 'done'`
/// carries no completion time, and `Block.updatedAt` is overwritten by the next
/// edit, so without this log "what did I finish today" is unanswerable.
///
/// workspaceId and userId are denormalised so a day can be queried without
/// joining Block — and so the record survives its block being hard-deleted,
/// which is itself an event worth keeping.
model Event {
  id       String @id @default(cuid())
  type     String
  metadata Json   @default("{}")

  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  workspaceId String?
  userId      String?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([blockId])
}

model SyncCursor {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  lastSyncedAt DateTime
  updatedAt    DateTime @updatedAt

  @@unique([userId, workspaceId])
}

// ── Tags ──────────────────────────────────────────────────────────────────────

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Tag?       @relation("TagChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Tag[]      @relation("TagChildren")
  blocks    BlockTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model BlockTag {
  blockId String
  tagId   String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blockId, tagId])
}

// ── Usage Tracking ────────────────────────────────────────────────────────────

model UsageEvent {
  id String @id @default(cuid())

  workspaceId String
  brandId     String?
  userId      String?

  service   String // "api" | "flownau" | "nauthenticity" | "zazu-bot"
  operation String // "chat_completion" | "embedding" | "transcription" | "apify_scrape"
  model     String? // "gpt-4o" | "text-embedding-3-small" | "whisper-1" | null
  provider  String? // "openai" | "groq" | "apify" | null

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  quantity         Float? // units consumed (e.g. characters, pages, API calls)
  unit             String? // "tokens" | "characters" | "calls"
  costUsd          Float? // estimated cost in USD

  metadata Json @default("{}")

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([brandId, createdAt])
  @@index([service, operation, createdAt])
}
